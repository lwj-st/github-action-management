{
  "name": "github-action-management",
  "version": "1.0.0",
  "description": "A lightweight GitHub Actions local control desktop application",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "cd src-tauri && ../node_modules/.bin/tauri --config tauri.conf.json",
    "tauri:dev": "cd src-tauri && ../node_modules/.bin/tauri dev --config tauri.conf.json",
    "tauri:build": "cd src-tauri && ../node_modules/.bin/tauri build --config tauri.conf.json",
    "tauri:build:mac": "cd src-tauri && ../node_modules/.bin/tauri build --config tauri.conf.json --bundles app",
    "tauri:build:windows": "cd src-tauri && ../node_modules/.bin/tauri build --config tauri.conf.json --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^1.5.0",
    "axios": "^1.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  }
}
